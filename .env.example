# Copy to .env and adjust. Every setting is optional unless noted.

# --- AI (required to ask questions in plain English) --------------------------
# OpenAI API key. Without it ABIET still runs, but only hand-written SQL works.
OPENAI_API_KEY=
# Model used to write SQL.
AI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible server instead of OpenAI (Azure OpenAI, Ollama,
# vLLM, LM Studio...), e.g. http://localhost:11434/v1 for Ollama.
# OPENAI_BASE_URL=
# Set to false if your server does not support JSON response mode.
# AI_JSON_MODE=true
# Some reasoning models only accept the default temperature; leave empty to omit it.
# AI_TEMPERATURE=0

# --- Security -----------------------------------------------------------------
# Signs login tokens and encrypts stored database passwords. If unset, one is
# generated in DATA_DIR/.secret_key. Changing it logs everyone out and makes
# stored connection passwords unreadable.
# SECRET_KEY=
# Allow new accounts after the first one (the first account is the administrator).
# ALLOW_REGISTRATION=true
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# Only needed when the UI is served from another origin, e.g. ["https://bi.example.com"]
# CORS_ORIGINS=[]

# --- Storage ------------------------------------------------------------------
# Folder for the internal SQLite database, secret key and demo database.
# DATA_DIR=data
# Use PostgreSQL (or another SQLAlchemy database) for ABIET's own data instead of SQLite.
# DATABASE_URL=postgresql+psycopg2://abiet:password@localhost:5432/abiet

# --- Query limits -------------------------------------------------------------
# QUERY_MAX_ROWS=1000
# EXPORT_MAX_ROWS=50000
# QUERY_TIMEOUT_SECONDS=30
# CONNECT_TIMEOUT_SECONDS=10
# AI_RATE_LIMIT_PER_MINUTE=30
# AI_MAX_REPAIR_ATTEMPTS=1

# --- Drivers ------------------------------------------------------------------
# MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
